{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "questions.schema.json",
  "title": "SC-200 Question Bank",
  "description": "SC-200 題庫檔格式。public/data/ 下的題庫 JSON 以 \"$schema\": \"./questions.schema.json\" 引用本檔，編輯器即可即時驗證。",
  "type": "object",
  "required": ["title", "chapters", "questions"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "version": { "type": "string" },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "questions": {
      "type": "array",
      "items": { "$ref": "#/$defs/question" }
    }
  },

  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
    "richText": {
      "type": "string",
      "description": "支援 `inline code`、**粗體**、以 \"- \" 開頭的清單行，空行分段。"
    },
    "option": {
      "type": "object",
      "required": ["id", "text"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z]$" },
        "text": { "type": "string" }
      },
      "additionalProperties": false
    },

    "base": {
      "type": "object",
      "required": ["id", "type", "question"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "type": "string" },
        "chapter": { "type": "string", "description": "對應 chapters[].id；題組子題不需要" },
        "difficulty": { "enum": ["easy", "medium", "hard"] },
        "tags": { "type": "array", "items": { "type": "string" } },
        "question": { "$ref": "#/$defs/richText" },
        "code": { "type": "string", "description": "選填，題幹下方的程式碼區塊" },
        "explanation": { "$ref": "#/$defs/richText" },
        "series": {
          "type": "string",
          "description": "選填，系列題代號：同一情境、各題提出不同 Solution 的題目使用相同代號，出題時會綁在一起連續出現"
        },
        "reviewNote": {
          "type": "string",
          "description": "選填，待人工確認的備註（例如來源答案可能有誤）；作答後會在解析區以醒目樣式顯示"
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "url"],
            "properties": {
              "title": { "type": "string" },
              "url": { "type": "string", "format": "uri" }
            },
            "additionalProperties": false
          }
        },
        "source": {
          "type": "object",
          "description": "選填，題目來源（例如 PDF 檔名與頁碼），由 scripts/parse_pdf.py 產生",
          "properties": {
            "file": { "type": "string" },
            "index": { "type": "integer", "description": "題目在來源 PDF 中的出現順序；題庫依此排序" },
            "number": { "type": ["string", "integer"] },
            "pages": { "type": "array", "items": { "type": "integer" } }
          }
        }
      }
    },

    "single_choice": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "properties": {
        "type": { "const": "single_choice" },
        "options": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/option" } },
        "answer": { "type": "string", "pattern": "^[A-Z]$" }
      },
      "required": ["options", "answer"]
    },

    "multiple_choice": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "properties": {
        "type": { "const": "multiple_choice" },
        "options": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/option" } },
        "answer": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z]$" },
          "description": "陣列長度即「請選擇 N 個答案」"
        }
      },
      "required": ["options", "answer"]
    },

    "dropdown_cloze": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "properties": {
        "type": { "const": "dropdown_cloze" },
        "templateType": { "enum": ["code", "text"], "default": "code" },
        "template": {
          "type": "string",
          "description": "以 {{blank_id}} 標示挖空位置，每個 id 需對應 blanks[].id"
        },
        "blanks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "options", "answer"],
            "properties": {
              "id": { "type": "string", "pattern": "^\\w+$" },
              "options": { "type": "array", "minItems": 2, "items": { "type": "string" } },
              "answer": { "type": "string", "description": "必須是 options 其中之一" }
            },
            "additionalProperties": false
          }
        }
      },
      "required": ["template", "blanks"]
    },

    "drag_drop_order": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "properties": {
        "type": { "const": "drag_drop_order" },
        "items": {
          "type": "array",
          "minItems": 2,
          "description": "所有可選步驟（可包含干擾項）",
          "items": {
            "type": "object",
            "required": ["id", "text"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "text": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "answer": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" },
          "description": "正確順序的 items[].id；長度即需排列的步驟數"
        }
      },
      "required": ["items", "answer"]
    },

    "statement_matrix": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "properties": {
        "type": { "const": "statement_matrix" },
        "columns": {
          "type": "array",
          "prefixItems": [{ "type": "string" }, { "type": "string" }],
          "items": false,
          "default": ["Yes", "No"]
        },
        "statements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "text", "answer"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "text": { "type": "string" },
              "answer": { "type": "boolean", "description": "true = Yes，false = No" }
            },
            "additionalProperties": false
          }
        }
      },
      "required": ["statements"]
    },

    "case_study": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "properties": {
        "type": { "const": "case_study" },
        "caseInfo": {
          "type": "object",
          "required": ["title", "sections"],
          "properties": {
            "title": { "type": "string" },
            "sections": {
              "type": "array",
              "minItems": 1,
              "description": "左欄背景資訊分頁，例如 Overview / Environment / Requirements",
              "items": {
                "type": "object",
                "required": ["title", "content"],
                "properties": {
                  "title": { "type": "string" },
                  "content": { "$ref": "#/$defs/richText" }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/subQuestion" }
        }
      },
      "required": ["caseInfo", "questions"]
    },

    "subQuestion": {
      "oneOf": [
        { "$ref": "#/$defs/single_choice" },
        { "$ref": "#/$defs/multiple_choice" },
        { "$ref": "#/$defs/dropdown_cloze" },
        { "$ref": "#/$defs/drag_drop_order" },
        { "$ref": "#/$defs/statement_matrix" }
      ]
    },

    "question": {
      "oneOf": [
        { "$ref": "#/$defs/single_choice" },
        { "$ref": "#/$defs/multiple_choice" },
        { "$ref": "#/$defs/dropdown_cloze" },
        { "$ref": "#/$defs/drag_drop_order" },
        { "$ref": "#/$defs/statement_matrix" },
        { "$ref": "#/$defs/case_study" }
      ]
    }
  }
}
